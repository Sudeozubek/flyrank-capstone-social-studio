# Environment — copy to `.env` and fill in. Never commit `.env`.

# Base URL the fake platform + webhook callbacks use to reach this app.
PUBLIC_BASE_URL=http://localhost:8080

# AES-256-GCM key material for OAuth-token encryption at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# HMAC secret used to sign and verify delivery webhooks.
# Generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# Fake-platform OAuth client credentials (any non-empty value works in sandbox).
INSTAGRAM_CLIENT_ID=dev-client-id
INSTAGRAM_CLIENT_SECRET=dev-client-secret
X_CLIENT_ID=dev-client-id
X_CLIENT_SECRET=dev-client-secret

# Set to "true" to keep the dev control panel API enabled in a production build.
ENABLE_DEV_PANEL=false
