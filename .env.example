# Environment configuration for CampaignHub Studio (FlyRank capstone).
# Copy to `.env` and fill in. `.env` is git-ignored — never commit real secrets.
# Nothing here is strictly required in the sandbox: every variable has a safe,
# clearly-labelled development fallback. Set real values before any deployment.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Base URL the app, the fake platform and webhook callbacks use to reach this
# instance. Must be the externally reachable origin in a deployment.
PUBLIC_BASE_URL=http://localhost:8080

# Origin the publisher adapters call for the in-repo fake platform.
# Leave unset to use PUBLIC_BASE_URL. No real social API is ever contacted.
FAKE_PLATFORM_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Security — generate each with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# AES-256-GCM key material for encrypting OAuth access tokens at rest.
# A fresh random IV is generated per write; plaintext tokens are never stored.
TOKEN_ENCRYPTION_KEY=

# HMAC-SHA256 secret used to sign delivery webhooks (fake platform) and to
# verify them (/api/public/webhooks/delivery). Both sides must share this value.
WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Database / auth (Supabase — your own project, not Lovable Cloud)
# Create a project at https://supabase.com, run supabase/flyrank-full-schema.sql
# in the SQL Editor, then paste credentials from Project Settings → API.
# ---------------------------------------------------------------------------

# Project API URL.
SUPABASE_URL=

# Publishable (anon) key — safe to expose to the browser; RLS enforces access.
SUPABASE_PUBLISHABLE_KEY=

# Secret / service-role key — server-only. NOT publishable or anon.
# Dashboard → API → «Secret key» (sb_secret_…) or Legacy «service_role» JWT.
# Optional if «Confirm email» is disabled under Authentication → Providers → Email.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Browser-visible equivalents consumed by the generated client.
# Must match SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Project ref (subdomain), e.g. urqzlvbmuouiwwjuqasd for https://urqzlvbmuouiwwjuqasd.supabase.co
VITE_SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Caption generation (optional)
# ---------------------------------------------------------------------------

# OpenAI API key used by the LLM caption writer (gpt-4o-mini). If this is
# missing — or the call times out, is rate limited, or errors — caption
# generation silently falls back to the deterministic composer. Campaign
# creation never fails because the model is unavailable.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime toggles
# ---------------------------------------------------------------------------

# Set to "true" to force the pure-JS Jimp image renderer instead of sharp.
# Useful on runtimes where sharp's native binary cannot load. Both renderers
# emit real PNGs at identical, exact platform dimensions.
FLYRANK_DISABLE_SHARP=false

# Set to "true" to keep the demo control rail (force 429, worker tick) enabled
# in a production build. Defaults to development-only.
ENABLE_DEV_PANEL=false
